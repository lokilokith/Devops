# ==========================================
# OpsForge Environment Variables Template
# ==========================================
# IMPORTANT: Never commit actual .env files to version control.
# Copy this file to `.env` and fill in the values before deploying.

# ------------------------------------------
# Environment Configuration
# ------------------------------------------
# APP_ENV must be one of: development, testing, production
APP_ENV=production

# ------------------------------------------
# Application Secrets
# ------------------------------------------
# A secure, unpredictable string used by Flask to sign session cookies and other crypto operations.
# MANDATORY in development and production.
SECRET_KEY="replace-this-with-a-secure-random-key"

# A secure string used to cryptographically sign JWT tokens.
# MANDATORY in production. In development, defaults to a fallback if omitted.
JWT_SECRET_KEY="replace-this-with-a-secure-jwt-key"

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
# The PostgreSQL root user created upon container initialization.
POSTGRES_USER=opsforge
# The PostgreSQL password.
POSTGRES_PASSWORD=opsforge_pass
# The PostgreSQL database name.
POSTGRES_DB=opsforge_db

# The SQLAlchemy connection string used by the backend.
# Should match the POSTGRES_ variables defined above.
DATABASE_URL=postgresql://opsforge:opsforge_pass@postgres:5432/opsforge_db

# ------------------------------------------
# Web Server Configuration
# ------------------------------------------
# The public port to expose the frontend Nginx web server (default 80)
PORT=80

# ------------------------------------------
# Security Configuration
# ------------------------------------------
# Restrict API CORS Origins (comma separated).
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost"
